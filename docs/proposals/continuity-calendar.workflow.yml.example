# INACTIVE. Root pins reviewed preparation source before the one owned QA activation.
name: Temporary Parola continuity and calendar checks 1
on:
  create:
permissions:
  contents: read
jobs:
  continuity-calendar:
    if: github.repository == 'alvarovillalbaa/parola' && github.event.repository.private == false && github.event.ref_type == 'branch' && github.event.ref == 'qa/parola-continuity-20261107-1' && github.ref == 'refs/heads/qa/parola-continuity-20261107-1'
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    env:
      CI: 'true'
      SOURCE_COMMIT: PREPARATION_SHA_REPLACED_BY_ROOT
      PAROLA_CONTINUITY_EXPECTED_DEPLOYMENT: dpl_AoT6kw5Z8KU1dwG4f3n2etRcCHcH
      PAROLA_CONTINUITY_PUBLIC_REPOSITORY: ${{ github.event.repository.private == false }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: ${{ env.SOURCE_COMMIT }}
          persist-credentials: false
          clean: false
          fetch-depth: 1
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1
        with:
          node-version: 24.21.0
          package-manager-cache: false
      - name: Check only the two pinned public continuity and calendar identities
        run: node scripts/run-continuity-calendar.mjs --source-commit "$SOURCE_COMMIT"
